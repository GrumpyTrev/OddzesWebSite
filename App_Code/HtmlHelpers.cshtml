@helper TransactionEntry(Transaction trans)
{
    <strong>@trans.Title</strong>
    <br />
    if ( trans.IsBalance == false )
    {
        <span>@string.Format("Paid by {0}", HelperMethods.UserNameString(trans.WhoId))</span>
    }
    else
    {
        <span>
            @string.Format("From {0} to {1}", HelperMethods.UserNameString(trans.WhoId),
                HelperMethods.UserNameString(trans.PaidToId))
        </span>
    }
}

@helper TransactionSummary(Transaction trans, bool open)
{
    if ( open == true )
    {
        <a href="@Href("~/Trips/Transaction", trans.Id)" style="padding:0px;">@TransactionEntry(trans)</a>
    }
    else
    {
        <span>@TransactionEntry(trans)</span>
    }
}


@helper PaymentEntry(Trip tripToDisplay, int fromUserId, int toUserId, double amount, int currencyId, bool open)
{
    <td>
        @if ( open == true )
        {
            <a href="@Href("~/Trips/AddPayment", tripToDisplay.Id, fromUserId, toUserId, amount, currencyId)" style="padding:0px;">
                Owes @HelperMethods.AmountString(amount, currencyId) to @HelperMethods.UserNameString(toUserId)
            </a>
        }
        else
        {
            <span>Owes @HelperMethods.AmountString(amount, currencyId) to @HelperMethods.UserNameString(toUserId)</span>
        }
    </td>
}

@helper DisplayTransactions(IEnumerable<Transaction> transactions, bool readOnly, string noContentMessage = "")
{
    if ( ( noContentMessage.Length > 0 ) && ( transactions.Count() == 0 ) )
    {
        <span>@noContentMessage</span>
    }
    else
    {
        // Keep track of which day is being displayed
        string dateString = "";

        <table style="margin-top:0px">
            @foreach ( Transaction trans in transactions )
            {
                string thisDateString = trans.Date.ToString("d MMM yyyy");

                // Already displaying transactions for this day for this month?
                if ( dateString != thisDateString )
                {
                    dateString = thisDateString;
                    <tr><td><strong>@dateString</strong></td></tr>
                }

                <tr>
                    <td class="tdNoPadWrap" style="padding-left:10px;">@TransactionSummary(trans, !readOnly)</td>

                    @if ( trans.CurrencyId == HelperMethods.SterlingId() )
                    {
                        <td class="tdNoPad" style="padding-left:5px;"><strong>@HelperMethods.AmountString(trans.LocalValue, trans.CurrencyId)</strong></td>
                    }
                    else
                    {
                        <td class="tdNoPad" style="padding-left:5px;">
                            <strong>@HelperMethods.AmountString(trans.LocalValue, trans.CurrencyId)</strong><br />
                            (@HelperMethods.AmountString(trans.SterlingValue, HelperMethods.SterlingId()))
                        </td>
                    }
                </tr>
            }
        </table>
    }
}

@helper DisplayExpenses(IEnumerable<UserExpense> expenses, int currencyId, Trip associatedTrip, bool open)
{
    <table style="margin-top:0px">
        @foreach ( UserExpense userExpense in expenses )
        {
            <tr>
                <td><strong>@userExpense.UserName</strong></td>
                <td>@HelperMethods.AmountString(userExpense.Paid, currencyId)</td>

                @if ( userExpense.Payments.Count > 0 )
                {
                    // Put the first payment on the same line as the total paid and then list any additional payments on separate
                    // lines below
                    @PaymentEntry(associatedTrip, userExpense.UserId, userExpense.Payments[0].ToUserId,
                            userExpense.Payments[0].Amount, currencyId, open)
                }
            </tr>

            // If there are additional payments then list these on separate lines below the first payment
            if ( userExpense.Payments.Count > 1 )
            {
                foreach ( BalancePayment payment in userExpense.Payments.Skip(1) )
                {
                    <tr>
                        <td></td>
                        <td></td>
                        @PaymentEntry(associatedTrip, userExpense.UserId, payment.ToUserId, payment.Amount, currencyId, open)
                    </tr>
                }
            }
        }
    </table>
}

@helper DisplayItineraryItem(ItineraryItem item, bool open)
{
    string titleString = "";

    if ( item.Time != null )
    {
        titleString = item.Time.Value.ToString("HH:mm") + ' ';

        if ( item.EndTime != null )
        {
            titleString += string.Format("- {0} ", item.EndTime.Value.ToString("HH:mm"));
        }
    }

    titleString += item.Title;

    if ( open == true )
    {
        <a href="@Href("~/Trips/AddItineraryItem", item.TripId, item.Id)" style="padding:0px;"><strong>@titleString</strong></a>
    }
    else
    {
        <span><strong>@titleString</strong></span>
    }
    
    if ( item.Details.IsEmpty() == false )
    {
        <br /><span style="white-space:pre-wrap">@item.Details</span>
    }
}

@helper DisplayItinerary(IEnumerable<ItineraryItem> items, bool open, string noContentMessage = "")
{
    if ( ( noContentMessage.Length > 0 ) && ( items.Count() == 0 ) )
    {
        <span>@noContentMessage</span>
    }
    else
    {
        // Keep track of which day is being displayed
        string dateString = "";
        <table style="margin-top:0px">
            @foreach ( ItineraryItem item in items )
            {
                string thisDateString = item.Date.ToString("dddd dd MMM yyyy");

                // Already displaying itinerary items for this day for this month?
                if ( dateString != thisDateString )
                {
                    dateString = thisDateString;
                    <tr><td><strong>@dateString</strong></td></tr>
                }
                <tr>
                    <td class="tdNoPadWrap" style="padding-left:10px;padding-bottom:3px">@DisplayItineraryItem(item, open)</td>
                </tr>
            }
        </table>
    }
}
