@{
    Layout = "~/Trips/_TripsLayout.cshtml";

    StarterSiteEntities model = new StarterSiteEntities();

    // This page can be used to update or delete an existing itinerary item if it is called with an itinerary item id,
    // otherwise it is used to add a new itinerary item to the trip specified by the trip id in the url.
    // The trip id is always the first parameter in the url, and the itinerary item id is the second parameter
    // if it is being used to update an existing item.

    int tripId = UrlData[0].AsInt();
    int itineraryItemId = UrlData[1].AsInt();

    string tripName = model.Trips.Single(trip => trip.Id == tripId).Name;

    // Initialise general page variables
    string title = "";
    string dateString = DateTime.Now.ToString("dd/MM/yyyy");
    string startTimeString = "";
    string endTimeString = "";
    string details = "";

    // If an itinerary item id was specified, this page is being used to update an existing item,
    // so populate the fields with the existing values
    ItineraryItem itemToEdit = null;

    if ( itineraryItemId > 0 )
    {
        itemToEdit = model.ItineraryItems.Single(item => item.Id == itineraryItemId);
        title = itemToEdit.Title;
        dateString = itemToEdit.Date.ToString("dd/MM/yyyy");
        if ( itemToEdit.Time != null )
        {
            startTimeString = itemToEdit.Time.Value.ToString("HH:mm");
        }
        if ( itemToEdit.EndTime != null )
        {
            endTimeString = itemToEdit.EndTime.Value.ToString("HH:mm");
        }
        details = itemToEdit.Details;
        Page.Title = "Edit itinerary item for trip " + tripName;
    }
    else
    {
        Page.Title = "Add itinerary item to trip " + tripName;
    }

    // Setup validation
    Validation.RequireField("title", "You must specify an item name.");

    // If this is a POST request, validate and process data
    if ( IsPost == true )
    {
        title = Request.Form["title"];
        dateString = Request.Form["date"];
        startTimeString = Request.Form["startTime"];
        endTimeString = Request.Form["endTime"];
        details = Request.Form["details"];

        // Convert the date string in dd/mm/yy format into a datetime to get around mobile/pc local differences
        DateTime date = DateTime.ParseExact(dateString, "dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture);

        // If a start time was specified, convert the time string into a datetime
        DateTime? startTime = null;
        if ( startTimeString.Length > 0 )
        {
            startTime = date.Date.Add(TimeSpan.Parse(startTimeString, System.Globalization.CultureInfo.InvariantCulture));
        }

        // If an end time was specified, convert the time string into a datetime
        DateTime? endTime = null;
        if ( endTimeString.Length > 0 )
        {
            endTime = date.Date.Add(TimeSpan.Parse(endTimeString, System.Globalization.CultureInfo.InvariantCulture));
        }

        // Check for 'action' values first
        if ( Request["action"] == "Add item" )
        {
            if ( Validation.IsValid() == true )
            {
                // Determine the index for the new item. This is one more than the current maximum index for items on the same date
                // for this trip
                int maxIndexForDate = model.ItineraryItems.Where(item => ( item.TripId == tripId ) && ( item.Date == date ))
                    .Select(item => item.ItemIndex).DefaultIfEmpty(0).Max();

                // Add a new itinerary item to the trip
                model.ItineraryItems.Add(new ItineraryItem
                {
                    Title = title,
                    Date = date,
                    TripId = tripId,
                    Time = startTime,
                    EndTime = endTime,
                    Details = details,
                    ItemIndex = maxIndexForDate + 1
                });

                model.SaveChanges();

                Response.Redirect(Href("~/Trips/Itinerary", tripId));
            }
        }
        else if ( Request["action"] == "Update item" )
        {
            if ( Validation.IsValid() == true )
            {
                // Update the existing itinerary item
                itemToEdit.Title = title;
                itemToEdit.Date = date;
                itemToEdit.Time = startTime;
                itemToEdit.EndTime = endTime;
                itemToEdit.Details = details;
                model.SaveChanges();
                Response.Redirect(Href("~/Trips/Itinerary", tripId));
            }
        }
        else if ( Request["action"] == "Delete item" )
        {
            // Delete the existing itinerary item
            model.ItineraryItems.Remove(itemToEdit);
            model.SaveChanges();
            Response.Redirect(Href("~/Trips/Itinerary", tripId));
        }
    }
}

<script type="text/javascript">
    $(document).ready(function () {
        $.datepicker.setDefaults($.extend({ 'dateFormat': 'dd/mm/yy' }, $.datepicker.regional['uk']));
        $("#date").datepicker();
    });

</script>

@section featured {
    <section class="featured">
        <div class="content-wrapper">
            <hgroup class="title">
                <h1>@Page.Title.</h1>
            </hgroup>
            @if ( WebSecurity.IsAuthenticated == true )
            {
                <p>Use the form below to add a new itinerary to the trip, or to edit an existing item</p>
            }
            else
            {
                <p>Please login to add a new itinerary item</p>
            }
        </div>
    </section>
}

@if ( WebSecurity.IsAuthenticated == true )
{
    <form id="itineraryItemForm" method="post">
        @Html.ValidationSummary("Operation was unsuccessful. Please correct the errors and try again.", excludeFieldErrors: true, htmlAttributes: null)

        <fieldset>
            <legend>Add new item</legend>
            <ol>
                <li>
                    <label for="title">Title</label>
                    <input style="width:93%" type="text" id="title" name="title" value="@title" @Validation.For("title") />
                    @Html.ValidationMessage("title")
                </li>
                <li>
                    <div class="flex-input">
                        <label for="date">Date</label>
                        @* Make the date field read only so that on mobiles the text input widget is not displayed *@
                        <input style="width:auto" type="text" id="date" name="date" value="@dateString" readonly="readonly" />
                    </div>
                </li>
                <li>
                    <div class="flex-input">
                        <label for="startTime">Start Time</label>
                        <input style="width:auto" type="time" id="time" name="startTime" value="@startTimeString" />
                        <label for="endTime">End Time</label>
                        <input style="width:auto" type="time" id="time" name="endTime" value="@endTimeString" />
                    </div>
                </li>
                <li>
                    <label for="details">Details</label>
                    <textarea style="width:93%; height:100px" id="details" name="details">@details</textarea>
                </li>
            </ol>
            @if ( itemToEdit == null )
            {
                <input type="submit" name="action" value="Add item" id="submit" />
            }
            else
            {
                <input type="submit" name="action" value="Update item" id="submit" />
                <input type="submit" name="action" value="Delete item" id="submit"
                       onclick="return confirm('Are you sure you want to delete this item?');" />
            }
            <a href="@Href("~/Trips/Itinerary", tripId)" class="btn">Cancel</a>

        </fieldset>
    </form>
}
