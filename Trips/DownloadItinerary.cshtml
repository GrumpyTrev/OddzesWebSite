@{
    StarterSiteEntities model = new StarterSiteEntities();

    // Get the trip id from the url
    int tripId = UrlData[0].AsInt();

    // Import the  Site.css file to style the itinerary that is being downloaded
    string cssString = File.ReadAllText(Server.MapPath(@"~\Content\Site.css"));

    // Create a string from the itineraries associated with this trip
    string itineraryString = @HtmlHelpers.DisplayItinerary(model.ItineraryItems.Where(item => item.TripId == tripId)
                                                .OrderBy(item => item.Date).ThenBy(item => item.ItemIndex), false).ToHtmlString();

    // Create the full page string by inserting the css and itinerary strings into an html template
    string pageString = string.Format("<html><head><style>{0}</style><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" /></head><body><div id=\"body\">{1}</div></body></html>", cssString, itineraryString);

    // Get the physical Path of the file to write the itinerary to
    string filepath = Server.MapPath(@"~\App_Data\itinerary.html");
    File.WriteAllText(filepath, pageString);

    // Create New instance of FileInfo class to get the properties of the file being downloaded
    FileInfo file = new FileInfo(filepath);

    // Clear the content of the response
    Response.ClearContent();

    // LINE1: Add the file name and attachment, which will force the open/cance/save dialog to show, to the header
    Response.AddHeader("Content-Disposition", "attachment; filename=" + file.Name);

    // Add the file size into the response header
    Response.AddHeader("Content-Length", file.Length.ToString());

    // Set the ContentType
    Response.ContentType = "text / plain";

    // Write the file into the response (TransmitFile is for ASP.NET 2.0. In ASP.NET 1.1 you have to use WriteFile instead)
    Response.TransmitFile(file.FullName);

    // End the response
    Response.End();
}