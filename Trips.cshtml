@{
    Layout = "~/Trips/_TripsLayout.cshtml";
    Page.Title = "Trips";
    StarterSiteEntities model = new StarterSiteEntities();

    // If this is a POST request, validate and process data
    if ( IsPost == true )
    {
        if ( Validation.IsValid() == true )
        {
            // Look for a trip to delete
            if ( string.IsNullOrEmpty(Request["deleteTripId"]) == false )
            {
                int tripId = Request["deleteTripId"].AsInt();

                // Delete each transaction and its associated sharers for this trip
                foreach ( Transaction transaction in model.Transactions.Where(trans => trans.TripId == tripId) )
                {
                    model.Sharers.RemoveRange(model.Sharers.Where(sharer => sharer.TransactionId == transaction.Id));
                    model.Transactions.Remove(transaction);
                }

                // Remove any tripper records associated with this trip
                model.Trippers.RemoveRange(model.Trippers.Where(tripper => tripper.TripId == tripId));

                // Now remove the trip record itself
                model.Trips.Remove(model.Trips.Single(trip => trip.Id == tripId));

                model.SaveChanges();

                // Reload the page
                Response.Redirect(Request.RawUrl);
            }
        }
    }
}

<script type="text/javascript">
    function deleteTrip(tripId, anyTransactions, name) {
        if (anyTransactions = true) {
            if (confirm('Trip ' + name + ' is not empty, are you sure you want to delete it?') == true) {
                document.getElementById('deleteTripId').value = tripId;
                document.getElementById('tripsForm').submit();
            }
        }
        else {
            if (confirm('Are you sure you want to delete trip ' + name) == true) {
                document.getElementById('deleteTripId').value = tripId;
                document.getElementById('tripsForm').submit();
            }
        }
    }
</script>

@section featured {
    <section class="featured">
        <div class="content-wrapper">
            <hgroup class="title">
                <h1>@Page.Title.</h1>
            </hgroup>
            @if ( WebSecurity.IsAuthenticated == true )
            {
                if ( model.Trips.Count() > 0 )
                {
                    <p>These are the available trips. Details can be shown by clicking on a category, or edited by opening the category</p>
                }
                else
                {
                    <p>There are no trips available. Use the button below to add a trip</p>
                }
            }
            else
            {
                <p>Please login to display the available trips</p>
            }
        </div>
    </section>
}


@if ( WebSecurity.IsAuthenticated == true )
{
    if ( model.Trips.Any() == true )
    {
        <form id="tripsForm" method="post">

            <input type="hidden" id="deleteTripId" name="deleteTripId" value="" />

            <table>
                @{
                    // Display the open trips first and then the closed trips
                    bool[] openStates = new bool[] { true, false };
                    foreach ( bool openState in openStates )
                    {
                        <tr><td colspan="5" class="tdNoPad"><strong>@( openState == true ? "Open trips" : "Closed trips" )</strong></td></tr>

                        foreach ( Trip trip in model.Trips.Where(trip => trip.Open == openState) )
                        {
                            // Display the trip name with edit and delete buttons
                            <tr>
                                <td class="tdNoPad" style="font-size: 1.75em;">
                                    @trip.Name
                                    <a href="@Href("~/Trips/EditTrip", trip.Name)" class="btn" style="height:24px; padding:0px">
                                        <i class='material-icons'>edit</i>
                                    </a>
                                    @if ( trip.Open == true )
                                    {
                                        // Only display the delete button for open trips
                                        <button class="btn" style="height:24px; padding:0px"
                                                onclick="@string.Format("deleteTrip( {0}, '{1}', '{2}');", trip.Id,
                                                            model.Transactions.Any(trans => trans.TripId == trip.Id), trip.Name)"
                                                type="button">
                                            <i class='material-icons'>delete</i>
                                        </button>
                                    }
                                </td>
                            </tr>

                            // Display the expenses (transactions) in a details element. Add an 'open' button for the transactions
                            <tr>
                                <td style="padding-left:10px">
                                    <details>
                                        <summary style="font-size:1.5em">Expenses
                                            <a href="@Href("~/Trips/Expenses", trip.Id, 0)" class="btn" style="height:24px; padding:0px">
                                                <i class='material-icons'>open_in_new</i>
                                            </a>
                                        </summary>
                                        <div style="margin-left: 16px;">
                                            @{
                                                // Display any closed expense records associated with this trip
                                                IEnumerable<ExpenseRecord> expenseRecord = model.ExpenseRecords
                                                    .Where(exp => ( exp.TripId == trip.Id ) && ( exp.Open == false ));

                                                foreach ( ExpenseRecord record in expenseRecord )
                                                {
                                                    // Display the expense record name with an open button, followed by
                                                    // the transactions
                                                    <details>
                                                        <summary>@record.Title [closed]
                                                            <a href="@Href("~/Trips/Expenses", trip.Id, record.Id)" 
                                                               class="btn" style="height:24px; padding:0px">
                                                                <i class='material-icons'>open_in_new</i>
                                                            </a>
                                                        </summary>
                                                        <div style="margin-left: 16px;">
                                                            @{
                                                                // Display the transactions associated with this record
                                                                @HtmlHelpers.DisplayTransactions(model.Transactions
                                                                    .Where(trans => ( trans.ExpensesId == record.Id ))
                                                                    .OrderByDescending(trans => trans.Date)
                                                                    .ThenByDescending(trans => trans.Id), true);
                                                            }
                                                        </div>
                                                    </details>
                                                }

                                                // Display current transactions if there are any
                                                @HtmlHelpers.DisplayTransactions(model.Transactions
                                                    .Where(trans => ( trans.TripId == trip.Id ) && ( trans.ExpensesId == 0 ))
                                                    .OrderByDescending(trans => trans.Date)
                                                    .ThenByDescending(trans => trans.Id), true,
                                                    "There are no expenses");
                                            }
                                        </div>
                                    </details>
                                </td>
                            </tr>

                            // Display the balance for the currently open expenses. Display read-only.
                            <tr>
                                <td style="padding-left:10px">
                                    <details>
                                        <summary style="font-size:1.5em">Balance
                                            <a href="@Href("~/Trips/Expenses", trip.Id, 0)" 
                                               class="btn" style="height:24px; padding:0px">
                                                <i class='material-icons'>open_in_new</i>
                                            </a>
                                        </summary>
                                        <div style="margin-left: 16px;">
                                            @HtmlHelpers.DisplayExpenses( 
                                                Expenses.GetExpensesForTrip(trip.Id, HelperMethods.SterlingId(), 0).UserExpenses, 
                                                HelperMethods.SterlingId(), 
                                                trip, false)
                                        </div>
                                    </details>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding-left:10px">
                                    <details>
                                        <summary style="font-size:1.5em">Itinerary</summary>
                                        <div style="margin-left: 16px;">
                                            <table>
                                                @{
                                                    IEnumerable<ItineraryItem> itineraryItems = model.ItineraryItems
                                                        .Where(item => item.TripId == trip.Id).OrderBy(item => item.Date);

                                                    // Keep track of which day is being displayed
                                                    string dateString = "";

                                                    foreach ( ItineraryItem item in itineraryItems )
                                                    {
                                                        string thisDateString = item.Date.ToString("dddd dd MMM yyyy");

                                                        // Already displaying transactions for this day for this month?
                                                        if ( dateString != thisDateString )
                                                        {
                                                            dateString = thisDateString;
                                                            <tr><td><strong>@dateString</strong></td></tr>
                                                        }

                                                        <tr>
                                                            <td style="padding-left:10px;">
                                                                @if ( item.Time != null )
                                                                {
                                                                    <strong>@item.Time.Value.ToString("HH:mm") </strong>
                                                                    if ( item.EndTime != null )
                                                                    {
                                                                        <strong>- @item.EndTime.Value.ToString("HH:mm") </strong>
                                                                    }
                                                                }
                                                                <strong>@item.Title</strong>
                                                                @if ( item.Details.IsEmpty() == false )
                                                                { 
                                                                    <br /><span>@item.Details</span>
                                                                }
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                            </table>
                                        </div>
                                    </details>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding-left:10px">
                                    <details>
                                        <summary style="font-size:1.5em">Activities/Ideas</summary>
                                    </details>
                                </td>
                            </tr>
                        }
                    }
                }
            </table>
        </form>
    }

    <p></p>
    <a href="~/Trips/AddTrip" class="btn">Add trip</a>
}

